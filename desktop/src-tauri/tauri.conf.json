{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinScore",
  "version": "0.1.0",
  "identifier": "io.github.pfefferniels.winscore",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WinScore",
        "width": 1400,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Music",
    "shortDescription": "Editor for SCORE .mus files",
    "longDescription": "An editor for scores in the file format of Leland Smith's music engraving program SCORE and its Windows version WinScore.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mus",
          "MUS"
        ],
        "name": "SCORE score",
        "description": "A score in Leland Smith's SCORE format",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-score",
        "exportedType": {
          "identifier": "io.github.pfefferniels.winscore.mus",
          "conformsTo": [
            "public.data",
            "public.content"
          ]
        }
      },
      {
        "ext": [
          "mus",
          "MUS"
        ],
        "name": "SCORE score (any .mus file)",
        "description": "A .mus file the system knows by another type",
        "role": "Editor",
        "rank": "Default"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "mainBinaryName": "WinScore"
}
